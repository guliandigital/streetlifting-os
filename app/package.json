{
  "name": "streetlifting-os-client",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "description": "Streetlifting OS — offline-first ISF Streetlifting & Calisthenics meet client",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext ts,tsx",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "powergage:migrate": "node scripts/powergage-migrate.mjs",
    "powertable:migrate": "node scripts/powertable-migrate.mjs",
    "release:validate-updater": "tsx scripts/validate-updater-config.ts",
    "pwa:validate": "tsx scripts/validate-pwa-build.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@mantine/core": "^7.13.0",
    "@mantine/dates": "^7.13.0",
    "@mantine/form": "^7.13.0",
    "@mantine/hooks": "^7.13.0",
    "@mantine/modals": "^7.13.0",
    "@mantine/notifications": "^7.13.0",
    "@reduxjs/toolkit": "^2.3.0",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "mantine-datatable": "^7.12.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^7.0.0",
    "zod": "^3.23.0"
